COMPOSE_PROJECT_NAME=church-production
APP_VERSION=local
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=8080
APP_BASE_URL=https://church.example.org
COOKIE_SECURE=true
LOG_LEVEL=info
POSTGRES_DB=church_management
POSTGRES_USER=church_app
POSTGRES_PASSWORD=CHANGE_ME_TO_RANDOM_32_PLUS_URL_SAFE_CHARACTERS

MFA_ENCRYPTION_KEY=CHANGE_ME_TO_64_HEX_CHARACTERS

POSTGRES_RUNTIME_PASSWORD=CHANGE_ME_TO_A_DIFFERENT_RANDOM_32_PLUS_URL_SAFE_VALUE

# Optional: required only when enabling sensitive care notes; separate 64-hex key.
CARE_ENCRYPTION_KEY=
