# Copy this file to deploy/.env.production on the server.
# Never commit the real production file.

APP_VERSION=local
APP_HTTP_PORT=8080
APP_BASE_URL=http://server-address:8080
APP_TIMEZONE=Asia/Seoul
LOG_LEVEL=info

POSTGRES_DB=church_management
POSTGRES_USER=church_app
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_BYTES
