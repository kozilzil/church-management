generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppMetadata {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_metadata")
}

model Church {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  timezone String @default("Asia/Seoul")
  users    User[]
  roles    Role[]

  @@map("church")
}

model User {
  careRecords      CareRecord[]
  newcomerJourneys NewcomerJourney[]
  scopeMode        String            @default("NONE") @map("scope_mode")
  memberId         String?           @map("member_id") @db.Uuid
  id               String            @id @default(uuid()) @db.Uuid
  churchId         String            @map("church_id") @db.Uuid
  username         String
  passwordHash     String?           @map("password_hash")
  authVersion      Int               @default(0) @map("auth_version")
  active           Boolean           @default(true)
  church           Church            @relation(fields: [churchId], references: [id], onDelete: Restrict)
  roles            UserRole[]
  sessions         Session[]
  totpSecret       String?           @map("totp_secret")
  totpEnabled      Boolean           @default(false) @map("totp_enabled")
  totpLastCounter  Int               @default(-1) @map("totp_last_counter")

  @@unique([churchId, id])
  @@unique([churchId, username])
  @@map("app_user")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  churchId    String           @map("church_id") @db.Uuid
  name        String
  church      Church           @relation(fields: [churchId], references: [id], onDelete: Restrict)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([churchId, id])
  @@unique([churchId, name])
  @@map("role")
}

model Permission {
  code  String           @id
  roles RolePermission[]

  @@map("permission")
}

model UserRole {
  churchId String @map("church_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid
  user     User   @relation(fields: [churchId, userId], references: [churchId, id], onDelete: Restrict)
  role     Role   @relation(fields: [churchId, roleId], references: [churchId, id], onDelete: Restrict)

  @@id([churchId, userId, roleId])
  @@map("user_role")
}

model RolePermission {
  roleId         String     @map("role_id") @db.Uuid
  permissionCode String     @map("permission_code")
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@map("role_permission")
}

model Session {
  authVersion Int      @default(0) @map("auth_version")
  tokenHash   String   @id @map("token_hash")
  churchId    String   @map("church_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [churchId, userId], references: [churchId, id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  expiresAt   DateTime @map("expires_at")
  mfaVerified Boolean  @default(false) @map("mfa_verified")

  @@index([expiresAt])
  @@map("session")
}

model LoginAttempt {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime @map("expires_at")

  @@map("login_attempt")
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  churchId      String   @map("church_id") @db.Uuid
  actorId       String   @map("actor_id") @db.Uuid
  roles         String[]
  action        String
  resourceType  String   @map("resource_type")
  resourceId    String   @map("resource_id")
  outcome       String   @default("success")
  correlationId String   @map("correlation_id")
  fields        String[]
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([churchId, createdAt])
  @@map("audit_event")
}

model MemberStatus {
  churchId    String   @map("church_id") @db.Uuid
  code        String
  label       String
  allowedNext String[] @map("allowed_next")

  @@id([churchId, code])
  @@map("member_status")
}

model Member {
  careRecords             CareRecord[]
  newcomerJourneys        NewcomerJourney[]
  attendanceRecords       AttendanceRecord[]
  organizationMemberships OrganizationMembership[]
  householdMemberships    HouseholdMembership[]
  id                      String                   @id @default(uuid()) @db.Uuid
  churchId                String                   @map("church_id") @db.Uuid
  memberNumber            String                   @map("member_number")
  name                    String
  normalizedName          String                   @map("normalized_name")
  phone                   String?
  normalizedPhone         String?                  @map("normalized_phone")
  address                 String?
  registeredOn            DateTime                 @map("registered_on") @db.Date
  status                  String
  version                 Int                      @default(1)

  @@unique([churchId, id])
  @@unique([churchId, memberNumber])
  @@index([churchId, normalizedName, id])
  @@index([churchId, normalizedPhone])
  @@map("member")
}

model MemberStatusHistory {
  id            String   @id @default(uuid()) @db.Uuid
  churchId      String   @map("church_id") @db.Uuid
  memberId      String   @map("member_id") @db.Uuid
  fromStatus    String?  @map("from_status")
  toStatus      String   @map("to_status")
  effectiveFrom DateTime @map("effective_from") @db.Date
  reason        String
  actorId       String   @map("actor_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([churchId, memberId, effectiveFrom])
  @@map("member_status_history")
}

model Household {
  careRecords CareRecord[]
  memberships HouseholdMembership[]
  id          String                @id @default(uuid()) @db.Uuid
  churchId    String                @map("church_id") @db.Uuid
  name        String
  phone       String?
  address     String?
  archivedAt  DateTime?             @map("archived_at")

  @@unique([churchId, id])
  @@map("household")
}

model HouseholdMembership {
  member         Member    @relation(fields: [churchId, memberId], references: [churchId, id])
  household      Household @relation(fields: [churchId, householdId], references: [churchId, id])
  id             String    @id @default(uuid()) @db.Uuid
  churchId       String    @map("church_id") @db.Uuid
  householdId    String    @map("household_id") @db.Uuid
  memberId       String    @map("member_id") @db.Uuid
  relationship   String
  representative Boolean   @default(false)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date

  @@index([churchId, householdId, effectiveFrom])
  @@index([churchId, memberId])
  @@map("household_membership")
}

model OrganizationType {
  churchId String @map("church_id") @db.Uuid
  code     String
  name     String

  @@id([churchId, code])
  @@map("organization_type")
}

model Organization {
  id       String    @id @default(uuid()) @db.Uuid
  churchId String    @map("church_id") @db.Uuid
  name     String
  type     String
  parentId String?   @map("parent_id") @db.Uuid
  closedOn DateTime? @map("closed_on") @db.Date

  @@unique([churchId, id])
  @@map("organization")
}

model OrganizationMembership {
  member         Member    @relation(fields: [churchId, memberId], references: [churchId, id])
  id             String    @id @default(uuid()) @db.Uuid
  churchId       String    @map("church_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  memberId       String    @map("member_id") @db.Uuid
  role           String
  primary        Boolean   @default(false)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date

  @@index([churchId, memberId])
  @@map("organization_membership")
}

model Position {
  id              String  @id @default(uuid()) @db.Uuid
  churchId        String  @map("church_id") @db.Uuid
  name            String
  sortOrder       Int     @default(0) @map("sort_order")
  allowConcurrent Boolean @default(false) @map("allow_concurrent")
  active          Boolean @default(true)

  @@unique([churchId, id])
  @@unique([churchId, name])
  @@map("position")
}

model PositionAppointment {
  id             String    @id @default(uuid()) @db.Uuid
  churchId       String    @map("church_id") @db.Uuid
  positionId     String    @map("position_id") @db.Uuid
  memberId       String    @map("member_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  positionName   String    @map("position_name")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date

  @@index([churchId, memberId])
  @@map("position_appointment")
}

model MemberRelation {
  id              String    @id @default(uuid()) @db.Uuid
  churchId        String    @map("church_id") @db.Uuid
  memberId        String    @map("member_id") @db.Uuid
  relatedMemberId String    @map("related_member_id") @db.Uuid
  relationship    String
  effectiveFrom   DateTime  @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date

  @@index([churchId, memberId])
  @@map("member_relation")
}

model UserScope {
  churchId       String  @map("church_id") @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  descendants    Boolean @default(false)

  @@id([churchId, userId, organizationId])
  @@map("user_scope")
}

model MemberImport {
  id        String    @id @default(uuid()) @db.Uuid
  churchId  String    @map("church_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  digest    String
  rows      Json
  appliedAt DateTime? @map("applied_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([churchId, userId, digest])
  @@map("member_import")
}

model MemberExport {
  id             String    @id @default(uuid()) @db.Uuid
  churchId       String    @map("church_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  query          String
  organizationId String?   @map("organization_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at")
  consumedAt     DateTime? @map("consumed_at")

  @@map("member_export")
}

model Gathering {
  id             String             @id @default(uuid()) @db.Uuid
  churchId       String             @map("church_id") @db.Uuid
  name           String
  organizationId String?            @map("organization_id") @db.Uuid
  schedule       String
  active         Boolean            @default(true)
  sessions       GatheringSession[]

  @@unique([churchId, id])
  @@map("gathering")
}

model GatheringSession {
  id          String             @id @default(uuid()) @db.Uuid
  churchId    String             @map("church_id") @db.Uuid
  gatheringId String             @map("gathering_id") @db.Uuid
  startsAt    DateTime           @map("starts_at")
  gathering   Gathering          @relation(fields: [churchId, gatheringId], references: [churchId, id])
  records     AttendanceRecord[]

  @@unique([churchId, id])
  @@unique([churchId, gatheringId, startsAt])
  @@index([churchId, startsAt])
  @@map("gathering_session")
}

model AttendanceRecord {
  id        String           @id @default(uuid()) @db.Uuid
  churchId  String           @map("church_id") @db.Uuid
  sessionId String           @map("session_id") @db.Uuid
  memberId  String           @map("member_id") @db.Uuid
  status    String
  source    String
  version   Int              @default(1)
  updatedAt DateTime         @updatedAt @map("updated_at")
  updatedBy String           @map("updated_by") @db.Uuid
  member    Member           @relation(fields: [churchId, memberId], references: [churchId, id])
  session   GatheringSession @relation(fields: [churchId, sessionId], references: [churchId, id])

  @@unique([churchId, id])
  @@unique([churchId, sessionId, memberId])
  @@index([churchId, memberId])
  @@map("attendance_record")
}

model AttendanceChange {
  id         String   @id @default(uuid()) @db.Uuid
  churchId   String   @map("church_id") @db.Uuid
  recordId   String   @map("record_id") @db.Uuid
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  source     String
  actorId    String   @map("actor_id") @db.Uuid
  version    Int
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([recordId, version])
  @@map("attendance_change")
}

model NewcomerStage {
  id        String            @id @default(uuid()) @db.Uuid
  churchId  String            @map("church_id") @db.Uuid
  name      String
  sortOrder Int               @map("sort_order")
  terminal  Boolean
  active    Boolean
  journeys  NewcomerJourney[]

  @@unique([churchId, id])
  @@unique([churchId, name])
  @@map("newcomer_stage")
}

model NewcomerJourney {
  id          String        @id @default(uuid()) @db.Uuid
  churchId    String        @map("church_id") @db.Uuid
  memberId    String        @map("member_id") @db.Uuid
  stageId     String        @map("stage_id") @db.Uuid
  assigneeId  String        @map("assignee_id") @db.Uuid
  dueOn       DateTime?     @map("due_on") @db.Date
  completedAt DateTime?     @map("completed_at")
  version     Int           @default(1)
  member      Member        @relation(fields: [churchId, memberId], references: [churchId, id])
  stage       NewcomerStage @relation(fields: [churchId, stageId], references: [churchId, id])
  assignee    User          @relation(fields: [churchId, assigneeId], references: [churchId, id])

  @@unique([churchId, id])
  @@unique([churchId, memberId])
  @@index([churchId, completedAt, dueOn])
  @@map("newcomer_journey")
}

model NewcomerChange {
  id         String    @id @default(uuid()) @db.Uuid
  churchId   String    @map("church_id") @db.Uuid
  journeyId  String    @map("journey_id") @db.Uuid
  fromStage  String?   @map("from_stage")
  toStage    String    @map("to_stage")
  assigneeId String    @map("assignee_id") @db.Uuid
  dueOn      DateTime? @map("due_on") @db.Date
  actorId    String    @map("actor_id") @db.Uuid
  version    Int
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([journeyId, version])
  @@map("newcomer_change")
}

model CareRecord {
  id          String     @id @default(uuid()) @db.Uuid
  churchId    String     @map("church_id") @db.Uuid
  memberId    String?    @map("member_id") @db.Uuid
  householdId String?    @map("household_id") @db.Uuid
  assigneeId  String     @map("assignee_id") @db.Uuid
  kind        String
  occurredAt  DateTime   @map("occurred_at")
  followUpOn  DateTime?  @map("follow_up_on") @db.Date
  completedAt DateTime?  @map("completed_at")
  version     Int        @default(1)
  member      Member?    @relation(fields: [churchId, memberId], references: [churchId, id])
  household   Household? @relation(fields: [churchId, householdId], references: [churchId, id])
  assignee    User       @relation(fields: [churchId, assigneeId], references: [churchId, id])

  @@unique([churchId, id])
  @@index([churchId, completedAt, followUpOn])
  @@map("care_record")
}

model CareChange {
  id          String    @id @default(uuid()) @db.Uuid
  churchId    String    @map("church_id") @db.Uuid
  recordId    String    @map("record_id") @db.Uuid
  assigneeId  String    @map("assignee_id") @db.Uuid
  followUpOn  DateTime? @map("follow_up_on") @db.Date
  completedAt DateTime? @map("completed_at")
  actorId     String    @map("actor_id") @db.Uuid
  version     Int
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([recordId, version])
  @@map("care_change")
}

model CarePolicy {
  churchId      String   @id @map("church_id") @db.Uuid
  enabled       Boolean  @default(false)
  retentionDays Int      @map("retention_days")
  reference     String
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("care_policy")
}

model CareNote {
  id         String    @id @default(uuid()) @db.Uuid
  churchId   String    @map("church_id") @db.Uuid
  recordId   String    @map("record_id") @db.Uuid
  authorId   String    @map("author_id") @db.Uuid
  visibility String
  roleId     String?   @map("role_id") @db.Uuid
  ciphertext String?
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  purgedAt   DateTime? @map("purged_at")

  @@index([expiresAt])
  @@map("care_note")
}

model FinanceAccount {
  id       String @id @default(uuid()) @db.Uuid
  churchId String @map("church_id") @db.Uuid
  code     String
  name     String
  kind     String

  @@unique([churchId, id])
  @@unique([churchId, code])
  @@map("finance_account")
}

model FinanceFund {
  id       String @id @default(uuid()) @db.Uuid
  churchId String @map("church_id") @db.Uuid
  name     String

  @@unique([churchId, id])
  @@unique([churchId, name])
  @@map("finance_fund")
}

model FinancePeriod {
  id       String    @id @default(uuid()) @db.Uuid
  churchId String    @map("church_id") @db.Uuid
  name     String
  startsOn DateTime  @map("starts_on") @db.Date
  endsOn   DateTime  @map("ends_on") @db.Date
  closedAt DateTime? @map("closed_at") @db.Timestamptz

  @@unique([churchId, id])
  @@map("finance_period")
}

model ExpenseRequest {
  currentApproverId String?             @map("current_approver_id") @db.Uuid
  id                String              @id @default(uuid()) @db.Uuid
  churchId          String              @map("church_id") @db.Uuid
  requesterId       String              @map("requester_id") @db.Uuid
  title             String
  purpose           String
  payee             String
  amount            Decimal             @db.Decimal(15, 0)
  accountId         String              @map("account_id") @db.Uuid
  fundId            String              @map("fund_id") @db.Uuid
  evidenceReference String              @default("") @map("evidence_reference")
  approverIds       String[]            @map("approver_ids") @db.Uuid
  state             String              @default("DRAFT")
  round             Int                 @default(0)
  version           Int                 @default(1)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  submissions       ExpenseSubmission[]

  @@unique([churchId, id])
  @@index([churchId, state, id])
  @@map("expense_request")
}

model ExpenseSubmission {
  id                String            @id @default(uuid()) @db.Uuid
  churchId          String            @map("church_id") @db.Uuid
  requestId         String            @map("request_id") @db.Uuid
  round             Int
  title             String
  purpose           String
  payee             String
  amount            Decimal           @db.Decimal(15, 0)
  accountId         String            @map("account_id") @db.Uuid
  fundId            String            @map("fund_id") @db.Uuid
  evidenceReference String            @map("evidence_reference")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  request           ExpenseRequest    @relation(fields: [churchId, requestId], references: [churchId, id])
  approvals         ExpenseApproval[]

  @@unique([churchId, id])
  @@unique([requestId, round])
  @@map("expense_submission")
}

model ExpenseApproval {
  id           String            @id @default(uuid()) @db.Uuid
  churchId     String            @map("church_id") @db.Uuid
  submissionId String            @map("submission_id") @db.Uuid
  position     Int
  userId       String            @map("user_id") @db.Uuid
  username     String
  decision     String            @default("PENDING")
  reason       String            @default("")
  decidedAt    DateTime?         @map("decided_at") @db.Timestamptz
  submission   ExpenseSubmission @relation(fields: [churchId, submissionId], references: [churchId, id])

  @@unique([submissionId, position])
  @@unique([submissionId, userId])
  @@map("expense_approval")
}

model ExpenseAttachment {
  id         String    @id @default(uuid()) @db.Uuid
  churchId   String    @map("church_id") @db.Uuid
  requestId  String    @map("request_id") @db.Uuid
  uploadedBy String    @map("uploaded_by") @db.Uuid
  filename   String
  mime       String
  size       Int
  sha256     String
  removedAt  DateTime? @map("removed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([churchId, id])
  @@index([requestId])
  @@map("expense_attachment")
}

model ExpenseSubmissionAttachment {
  churchId     String @map("church_id") @db.Uuid
  submissionId String @map("submission_id") @db.Uuid
  attachmentId String @map("attachment_id") @db.Uuid

  @@id([submissionId, attachmentId])
  @@map("expense_submission_attachment")
}

model ExpenseEvent {
  id        String   @id @default(uuid()) @db.Uuid
  churchId  String   @map("church_id") @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String
  reason    String   @default("")
  version   Int
  round     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([requestId, version])
  @@map("expense_event")
}

model ExpensePayment {
  id        String   @id @default(uuid()) @db.Uuid
  churchId  String   @map("church_id") @db.Uuid
  requestId String   @unique @map("request_id") @db.Uuid
  paidBy    String   @map("paid_by") @db.Uuid
  paidOn    DateTime @map("paid_on") @db.Date
  method    String
  reference String
  amount    Decimal  @db.Decimal(15, 0)
  journalId String   @unique @map("journal_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([churchId, reference])
  @@map("expense_payment")
}

model JournalEntry {
  id          String        @id @default(uuid()) @db.Uuid
  churchId    String        @map("church_id") @db.Uuid
  periodId    String        @map("period_id") @db.Uuid
  postedOn    DateTime      @map("posted_on") @db.Date
  postedBy    String        @map("posted_by") @db.Uuid
  description String
  reversalOf  String?       @unique @map("reversal_of") @db.Uuid
  createdXid  BigInt        @default(dbgenerated("txid_current()")) @map("created_xid")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  lines       JournalLine[]

  @@unique([churchId, id])
  @@index([churchId, postedOn, id])
  @@map("journal_entry")
}

model JournalLine {
  id        String       @id @default(uuid()) @db.Uuid
  churchId  String       @map("church_id") @db.Uuid
  journalId String       @map("journal_id") @db.Uuid
  accountId String       @map("account_id") @db.Uuid
  fundId    String       @map("fund_id") @db.Uuid
  debit     Decimal      @default(0) @db.Decimal(15, 0)
  credit    Decimal      @default(0) @db.Decimal(15, 0)
  entry     JournalEntry @relation(fields: [churchId, journalId], references: [churchId, id])

  @@map("journal_line")
}

model OfferingType {
  id               String  @id @default(uuid()) @db.Uuid
  churchId         String  @map("church_id") @db.Uuid
  name             String
  revenueAccountId String  @map("revenue_account_id") @db.Uuid
  fundId           String  @map("fund_id") @db.Uuid
  receiptEligible  Boolean @map("receipt_eligible")

  @@unique([churchId, id])
  @@unique([churchId, name])
  @@map("offering_type")
}

model OfferingDonor {
  id       String  @id @default(uuid()) @db.Uuid
  churchId String  @map("church_id") @db.Uuid
  memberId String? @map("member_id") @db.Uuid
  name     String
  address  String
  version  Int     @default(1)

  @@unique([churchId, id])
  @@unique([churchId, memberId])
  @@index([churchId, name, id])
  @@map("offering_donor")
}

model Offering {
  id             String   @id @default(uuid()) @db.Uuid
  churchId       String   @map("church_id") @db.Uuid
  donorId        String?  @map("donor_id") @db.Uuid
  typeId         String   @map("type_id") @db.Uuid
  assetAccountId String   @map("asset_account_id") @db.Uuid
  givenOn        DateTime @map("given_on") @db.Date
  amount         Decimal  @db.Decimal(15, 0)
  reference      String
  source         String
  state          String   @default("DRAFT")
  version        Int      @default(1)
  createdBy      String   @map("created_by") @db.Uuid
  editedBy       String   @map("edited_by") @db.Uuid
  reviewedBy     String?  @map("reviewed_by") @db.Uuid
  journalId      String?  @unique @map("journal_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([churchId, id])
  @@unique([churchId, reference])
  @@index([churchId, donorId, givenOn, id])
  @@map("offering")
}

model OfferingReversal {
  id         String   @id @default(uuid()) @db.Uuid
  churchId   String   @map("church_id") @db.Uuid
  offeringId String   @unique @map("offering_id") @db.Uuid
  journalId  String   @unique @map("journal_id") @db.Uuid
  reason     String
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("offering_reversal")
}

model OfferingEvent {
  id         String   @id @default(uuid()) @db.Uuid
  churchId   String   @map("church_id") @db.Uuid
  offeringId String   @map("offering_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  reason     String   @default("")
  version    Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([offeringId, version])
  @@map("offering_event")
}

model ReceiptIssuer {
  churchId               String  @id @map("church_id") @db.Uuid
  name                   String
  registrationNumber     String  @map("registration_number")
  address                String
  representative         String
  legalBasis             String  @map("legal_basis")
  qualificationReference String  @map("qualification_reference")
  electronicRequired     Boolean @map("electronic_required")
  version                Int     @default(1)

  @@map("receipt_issuer")
}

model DonationReceipt {
  id                       String                @id @default(uuid()) @db.Uuid
  churchId                 String                @map("church_id") @db.Uuid
  donorId                  String                @map("donor_id") @db.Uuid
  taxYear                  Int                   @map("tax_year")
  serialYear               Int                   @map("serial_year")
  serial                   Int
  number                   String
  donorName                String                @map("donor_name")
  donorAddress             String                @map("donor_address")
  issuerName               String                @map("issuer_name")
  issuerRegistrationNumber String                @map("issuer_registration_number")
  issuerAddress            String                @map("issuer_address")
  issuerRepresentative     String                @map("issuer_representative")
  issuerLegalBasis         String                @map("issuer_legal_basis")
  qualificationReference   String                @map("qualification_reference")
  totalAmount              Decimal               @map("total_amount") @db.Decimal(18, 0)
  issuedBy                 String                @map("issued_by") @db.Uuid
  issuedOn                 DateTime              @map("issued_on") @db.Date
  createdXid               BigInt                @default(dbgenerated("txid_current()")) @map("created_xid")
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz
  items                    DonationReceiptItem[]

  @@unique([churchId, id])
  @@unique([churchId, serialYear, serial])
  @@unique([churchId, number])
  @@index([churchId, donorId, taxYear, id])
  @@map("donation_receipt")
}

model DonationReceiptItem {
  id         String          @id @default(uuid()) @db.Uuid
  churchId   String          @map("church_id") @db.Uuid
  receiptId  String          @map("receipt_id") @db.Uuid
  offeringId String          @map("offering_id") @db.Uuid
  givenOn    DateTime        @map("given_on") @db.Date
  amount     Decimal         @db.Decimal(15, 0)
  typeName   String          @map("type_name")
  receipt    DonationReceipt @relation(fields: [churchId, receiptId], references: [churchId, id])

  @@unique([receiptId, offeringId])
  @@map("donation_receipt_item")
}

model ReceiptClaim {
  offeringId    String  @id @map("offering_id") @db.Uuid
  churchId      String  @map("church_id") @db.Uuid
  receiptId     String? @map("receipt_id") @db.Uuid
  hometaxItemId String? @unique @map("hometax_item_id") @db.Uuid

  @@map("receipt_claim")
}

model HometaxSubmission {
  id                       String        @id @default(uuid()) @db.Uuid
  churchId                 String        @map("church_id") @db.Uuid
  requestId                String        @map("request_id") @db.Uuid
  donorId                  String        @map("donor_id") @db.Uuid
  taxYear                  Int           @map("tax_year")
  donorName                String        @map("donor_name")
  issuerName               String        @map("issuer_name")
  issuerRegistrationNumber String        @map("issuer_registration_number")
  contactName              String        @map("contact_name")
  contactPhone             String        @map("contact_phone")
  preparedOn               DateTime      @map("prepared_on") @db.Date
  totalAmount              Decimal       @map("total_amount") @db.Decimal(18, 0)
  preparedBy               String        @map("prepared_by") @db.Uuid
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz
  createdXid               BigInt        @default(dbgenerated("txid_current()")) @map("created_xid")
  items                    HometaxItem[]

  @@unique([churchId, id])
  @@unique([churchId, requestId])
  @@index([churchId, donorId, taxYear, id])
  @@map("hometax_submission")
}

model HometaxItem {
  id           String            @id @default(uuid()) @db.Uuid
  churchId     String            @map("church_id") @db.Uuid
  submissionId String            @map("submission_id") @db.Uuid
  offeringId   String            @map("offering_id") @db.Uuid
  givenOn      DateTime          @map("given_on") @db.Date
  amount       Decimal           @db.Decimal(15, 0)
  submission   HometaxSubmission @relation(fields: [churchId, submissionId], references: [churchId, id])
  results      HometaxResult[]

  @@unique([churchId, id])
  @@unique([churchId, id, offeringId])
  @@unique([submissionId, offeringId])
  @@map("hometax_item")
}

model HometaxResult {
  id         String      @id @default(uuid()) @db.Uuid
  churchId   String      @map("church_id") @db.Uuid
  itemId     String      @map("item_id") @db.Uuid
  state      String
  reference  String
  reason     String
  recordedBy String      @map("recorded_by") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  item       HometaxItem @relation(fields: [churchId, itemId], references: [churchId, id])

  @@unique([itemId, state])
  @@map("hometax_result")
}

model ReceiptCancellation {
  receiptId   String   @id @map("receipt_id") @db.Uuid
  churchId    String   @map("church_id") @db.Uuid
  reason      String
  cancelledBy String   @map("cancelled_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("receipt_cancellation")
}
