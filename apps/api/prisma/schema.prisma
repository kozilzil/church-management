generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppMetadata {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_metadata")
}

model Church {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  timezone String @default("Asia/Seoul")
  users    User[]
  roles    Role[]

  @@map("church")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  churchId        String     @map("church_id") @db.Uuid
  username        String
  passwordHash    String?    @map("password_hash")
  authVersion     Int        @default(0) @map("auth_version")
  active          Boolean    @default(true)
  church          Church     @relation(fields: [churchId], references: [id], onDelete: Restrict)
  roles           UserRole[]
  sessions        Session[]
  totpSecret      String?    @map("totp_secret")
  totpEnabled     Boolean    @default(false) @map("totp_enabled")
  totpLastCounter Int        @default(-1) @map("totp_last_counter")

  @@unique([churchId, id])
  @@unique([churchId, username])
  @@map("app_user")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  churchId    String           @map("church_id") @db.Uuid
  name        String
  church      Church           @relation(fields: [churchId], references: [id], onDelete: Restrict)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([churchId, id])
  @@unique([churchId, name])
  @@map("role")
}

model Permission {
  code  String           @id
  roles RolePermission[]

  @@map("permission")
}

model UserRole {
  churchId String @map("church_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid
  user     User   @relation(fields: [churchId, userId], references: [churchId, id], onDelete: Restrict)
  role     Role   @relation(fields: [churchId, roleId], references: [churchId, id], onDelete: Restrict)

  @@id([churchId, userId, roleId])
  @@map("user_role")
}

model RolePermission {
  roleId         String     @map("role_id") @db.Uuid
  permissionCode String     @map("permission_code")
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@map("role_permission")
}

model Session {
  authVersion Int      @default(0) @map("auth_version")
  tokenHash   String   @id @map("token_hash")
  churchId    String   @map("church_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [churchId, userId], references: [churchId, id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  expiresAt   DateTime @map("expires_at")
  mfaVerified Boolean  @default(false) @map("mfa_verified")

  @@index([expiresAt])
  @@map("session")
}

model LoginAttempt {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime @map("expires_at")

  @@map("login_attempt")
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  churchId      String   @map("church_id") @db.Uuid
  actorId       String   @map("actor_id") @db.Uuid
  roles         String[]
  action        String
  resourceType  String   @map("resource_type")
  resourceId    String   @map("resource_id")
  outcome       String   @default("success")
  correlationId String   @map("correlation_id")
  fields        String[]
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([churchId, createdAt])
  @@map("audit_event")
}

model MemberStatus {
  churchId    String   @map("church_id") @db.Uuid
  code        String
  label       String
  allowedNext String[] @map("allowed_next")

  @@id([churchId, code])
  @@map("member_status")
}

model Member {
  id              String   @id @default(uuid()) @db.Uuid
  churchId        String   @map("church_id") @db.Uuid
  memberNumber    String   @map("member_number")
  name            String
  normalizedName  String   @map("normalized_name")
  phone           String?
  normalizedPhone String?  @map("normalized_phone")
  address         String?
  registeredOn    DateTime @map("registered_on") @db.Date
  status          String
  version         Int      @default(1)

  @@unique([churchId, id])
  @@unique([churchId, memberNumber])
  @@index([churchId, normalizedName, id])
  @@index([churchId, normalizedPhone])
  @@map("member")
}

model MemberStatusHistory {
  id            String   @id @default(uuid()) @db.Uuid
  churchId      String   @map("church_id") @db.Uuid
  memberId      String   @map("member_id") @db.Uuid
  fromStatus    String?  @map("from_status")
  toStatus      String   @map("to_status")
  effectiveFrom DateTime @map("effective_from") @db.Date
  reason        String
  actorId       String   @map("actor_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([churchId, memberId, effectiveFrom])
  @@map("member_status_history")
}

model Household {
  id         String    @id @default(uuid()) @db.Uuid
  churchId   String    @map("church_id") @db.Uuid
  name       String
  phone      String?
  address    String?
  archivedAt DateTime? @map("archived_at")

  @@unique([churchId, id])
  @@map("household")
}

model HouseholdMembership {
  id             String    @id @default(uuid()) @db.Uuid
  churchId       String    @map("church_id") @db.Uuid
  householdId    String    @map("household_id") @db.Uuid
  memberId       String    @map("member_id") @db.Uuid
  relationship   String
  representative Boolean   @default(false)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date

  @@index([churchId, householdId, effectiveFrom])
  @@index([churchId, memberId])
  @@map("household_membership")
}

model OrganizationType {
  churchId String @map("church_id") @db.Uuid
  code     String
  name     String

  @@id([churchId, code])
  @@map("organization_type")
}

model Organization {
  id       String    @id @default(uuid()) @db.Uuid
  churchId String    @map("church_id") @db.Uuid
  name     String
  type     String
  parentId String?   @map("parent_id") @db.Uuid
  closedOn DateTime? @map("closed_on") @db.Date

  @@unique([churchId, id])
  @@map("organization")
}

model OrganizationMembership {
  id             String    @id @default(uuid()) @db.Uuid
  churchId       String    @map("church_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  memberId       String    @map("member_id") @db.Uuid
  role           String
  primary        Boolean   @default(false)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date

  @@index([churchId, memberId])
  @@map("organization_membership")
}

model Position {
  id              String  @id @default(uuid()) @db.Uuid
  churchId        String  @map("church_id") @db.Uuid
  name            String
  sortOrder       Int     @default(0) @map("sort_order")
  allowConcurrent Boolean @default(false) @map("allow_concurrent")
  active          Boolean @default(true)

  @@unique([churchId, id])
  @@unique([churchId, name])
  @@map("position")
}

model PositionAppointment {
  id             String    @id @default(uuid()) @db.Uuid
  churchId       String    @map("church_id") @db.Uuid
  positionId     String    @map("position_id") @db.Uuid
  memberId       String    @map("member_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  positionName   String    @map("position_name")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date

  @@index([churchId, memberId])
  @@map("position_appointment")
}

model MemberRelation {
  id              String    @id @default(uuid()) @db.Uuid
  churchId        String    @map("church_id") @db.Uuid
  memberId        String    @map("member_id") @db.Uuid
  relatedMemberId String    @map("related_member_id") @db.Uuid
  relationship    String
  effectiveFrom   DateTime  @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date

  @@index([churchId, memberId])
  @@map("member_relation")
}
