{
  "name": "church-management",
  "version": "0.1.0",
  "private": true,
  "description": "Korean church membership and finance management system",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @church/api --filter @church/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present lint",
    "postinstall": "pnpm db:generate",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @church/api prisma:generate",
    "db:migrate": "pnpm --filter @church/api prisma:migrate",
    "db:deploy": "pnpm --filter @church/api prisma:deploy",
    "db:reset": "pnpm --filter @church/api prisma:reset",
    "db:seed": "pnpm --filter @church/api prisma:seed",
    "db:validate": "pnpm --filter @church/api prisma:validate",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
