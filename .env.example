# Development database used by compose.yaml
POSTGRES_DB=church_management
POSTGRES_USER=church_app
POSTGRES_PORT=5432

# Development DB is bound to 127.0.0.1 and uses local trust authentication.
# Production must always use an authenticated connection configured outside Git.
DATABASE_URL=postgresql://church_app@127.0.0.1:5432/church_management?schema=public
API_PORT=3000
WEB_PORT=5173
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
